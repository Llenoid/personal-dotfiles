[
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "space f": "workspace::ToggleRightDock",
      "space t": "workspace::ToggleBottomDock",

      "escape": "editor::Cancel",

      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",

      "space |": "pane::SplitRight",
      "space _": "pane::SplitDown",
      "space w d": "pane::CloseActiveItem",

      "[ b": "pane::ActivatePreviousItem",
      "] b": "pane::ActivateNextItem",
      "space b d": "pane::CloseActiveItem",

      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"],
      "n": ["workspace::SendKeystrokes", "n z z"],
      "N": ["workspace::SendKeystrokes", "N z z"],

      "space y": ["workspace::SendKeystrokes", "\" + y"],
      "space Y": ["workspace::SendKeystrokes", "\" + Y"],
      "space d": ["workspace::SendKeystrokes", "\" _ d"],

      "[ d": "editor::GoToPreviousDiagnostic",
      "] d": "editor::GoToDiagnostic",
      "space e": "editor::Hover",
      "space q": "diagnostics::Deploy",
      "space v h": "editor::ToggleInlayHints",
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDefinitionSplit",
      "g i": "editor::GoToImplementation",
      "g r r": "editor::FindAllReferences",

      "[ q": "editor::GoToPreviousDiagnostic",
      "] q": "editor::GoToDiagnostic",
      "space q o": "diagnostics::Deploy",

      "space space": "file_finder::Toggle",
      "space /": "pane::DeploySearch"
    }
  },

  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "J": "editor::MoveLineDown",
      "K": "editor::MoveLineUp",

      "space y": ["workspace::SendKeystrokes", "\" + y"],
      "space p": ["workspace::SendKeystrokes", "\" _ d p"],
      "space d": ["workspace::SendKeystrokes", "\" _ d"],

      "<": "editor::Outdent",
      ">": "editor::Indent",
      "g c": "editor::ToggleComments"
    }
  },

  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-y": "editor::ConfirmCompletion"
    }
  },

  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "space f": "workspace::ToggleRightDock",
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "h": "project_panel::CollapseSelectedEntry",
      "l": "project_panel::ExpandSelectedEntry"
    }
  },

  {
    "context": "Dock",
    "bindings": {
      "q": "workspace::ToggleRightDock",
      "ctrl-h": "workspace::ActivatePaneLeft"
    }
  },

  {
    "context": "Terminal",
    "bindings": {
      "ctrl-k": "workspace::ActivatePaneUp",
      "space t": "workspace::ToggleBottomDock"
    }
  }
]
