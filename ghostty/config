# resize_split
keybind = ctrl+alt+up=resize_split:up,4
keybind = ctrl+alt+down=resize_split:down,4
keybind = ctrl+alt+right=resize_split:right,4
keybind = ctrl+alt+left=resize_split:left,4

# split_navigation
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+l=goto_split:right
keybind = alt+k=goto_split:top
keybind = ctrl+left_bracket=goto_split:previous
keybind = ctrl+right_bracket=goto_split:next

keybind = alt+\=new_split:right
keybind = alt+-=new_split:down

keybind = ctrl+shift+w=close_surface 
keybind = alt+z=toggle_split_zoom

